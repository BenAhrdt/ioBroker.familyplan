          "min": 0,
          "max": 365,
          "default": 31,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          },
          "lg": 3,
          "xl": 3
        },
        "futureDays": {
          "type": "number",
          "label": "Following days",
          "help": "Extends the selected period after its end.",
