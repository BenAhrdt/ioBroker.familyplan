        },
        "wasteReminderEnabled": {
          "type": "checkbox",
          "label": "Enable reminder",
          "xs": 12,
          "sm": 4,
          "default": true,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "wasteReminderDays": {
          "type": "number",
          "label": "Days before collection",
          "min": 0,
          "step": 1,
          "default": 1,
          "xs": 12,
          "sm": 4,
          "disabled": "!data.wasteReminderEnabled",
          "validator": "Number.isSafeInteger(data.wasteReminderDays) && data.wasteReminderDays >= 0",
          "validatorNoSaveOnError": true,
          "validatorErrorText": "Bitte eine ganze Zahl ab 0 eingeben.",
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "wasteReminderTime": {
          "type": "text",
          "label": "Time (HH:mm)",
          "default": "15:00",
          "validator": "/^(?:[01][0-9]|2[0-3]):[0-5][0-9]$/.test(data.wasteReminderTime)",
          "xs": 12,
          "sm": 4,
          "disabled": "!data.wasteReminderEnabled",
          "validatorNoSaveOnError": true,
          "validatorErrorText": "Bitte eine Uhrzeit im Format HH:mm eingeben.",
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "_reminderHelp": {
          "type": "staticText",
          "text": "Groups all waste types for one collection day. Acknowledge via waste.reminder.reset. The reminder expires at the end of the collection day. Uses the configured time zone.",
