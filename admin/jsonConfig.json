            "en": "Separator"
          },
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "wasteEmptyText": {
          "type": "text",
          "label": {
            "de": "Leertext",
            "en": "Empty text"
          },
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "_templates": {
          "type": "header",
          "text": {
            "de": "Nachrichtenvorlagen",
            "en": "Message templates"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "wasteTodayTemplate": {
          "type": "text",
          "label": {
            "de": "Vorlage heute",
            "en": "Today template"
          },
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "wasteTomorrowTemplate": {
          "type": "text",
          "label": {
            "de": "Vorlage morgen",
            "en": "Tomorrow template"
          },
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "wasteFutureTemplate": {
          "type": "text",
          "label": {
            "de": "Vorlage weitere Tage",
            "en": "Future template"
          },
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "_placeholders": {
          "type": "staticText",
          "text": {
            "de": "Platzhalter: {title}, {wasteType}, {date}, {days}.",
            "en": "Placeholders: {title}, {wasteType}, {date}, {days}."
          },
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          }
        },
        "_names": {
          "type": "header",
          "text": {
            "de": "Eigene Bezeichnungen",
            "en": "Custom names"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "wasteMappings": {
          "type": "table",
          "label": {
            "de": "Titel-Zuordnung",
            "en": "Title mappings"
          },
          "newLine": true,
          "items": [
            {
              "type": "text",
              "attr": "match",
              "title": {
                "de": "Titel enthält",
                "en": "Title contains"
              }
            },
            {
              "type": "text",
              "attr": "name",
              "title": {
                "de": "Anzeigename",
                "en": "Display name"
              }
            }
          ],
          "xs": 12,
          "style": {
            "marginBottom": 12
          },
          "sm": 12,
          "md": 12
        },
        "_reminder": {
          "type": "header",
          "text": {
            "de": "Erinnerung",
            "en": "Reminder"
          },
          "size": 3,
          "xs": 12,
          "newLine": true
        },
        "wasteReminderEnabled": {
          "type": "checkbox",
          "label": {
            "de": "Erinnerung aktivieren",
            "en": "Enable reminder"
          },
          "xs": 12,
          "sm": 4,
          "default": true
        },
        "wasteReminderDays": {
          "type": "number",
          "label": {
            "de": "Tage vor der Abholung",
            "en": "Days before collection"
          },
          "min": 0,
          "step": 1,
          "default": 1,
          "xs": 12,
          "sm": 4,
          "disabled": "!data.wasteReminderEnabled",
          "validator": "Number.isSafeInteger(data.wasteReminderDays) && data.wasteReminderDays >= 0",
          "validatorNoSaveOnError": true,
          "validatorErrorText": "Bitte eine ganze Zahl ab 0 eingeben."
        },
        "wasteReminderTime": {
          "type": "text",
          "label": {
            "de": "Uhrzeit (HH:mm)",
            "en": "Time (HH:mm)"
          },
          "default": "15:00",
          "validator": "/^(?:[01][0-9]|2[0-3]):[0-5][0-9]$/.test(data.wasteReminderTime)",
          "xs": 12,
          "sm": 4,
          "disabled": "!data.wasteReminderEnabled",
          "validatorNoSaveOnError": true,
          "validatorErrorText": "Bitte eine Uhrzeit im Format HH:mm eingeben."
        },
        "_reminderHelp": {
          "type": "staticText",
          "text": {
            "de": "Fasst alle Abfallarten eines Abholtages zusammen. Über waste.reminder.reset quittieren. Die Erinnerung endet automatisch am Ende des Abholtages. Uhrzeit in der eingestellten Zeitzone.",
            "en": "Groups all waste types for one collection day. Acknowledge via waste.reminder.reset. The reminder expires at the end of the collection day. Uses the configured time zone."
          },
          "xs": 12
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
    },
    "triggers": {
