          "min": 0,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          },
          "lg": 3,
          "xl": 3
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
