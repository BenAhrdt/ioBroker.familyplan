          "max": 365,
          "default": 31,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          },
          "lg": 3,
          "xl": 3
        },
        "pollInterval": {
          "type": "number",
