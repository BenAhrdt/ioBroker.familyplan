          "label": {
            "de": "Aktiviert",
            "en": "Enabled"
          },
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "wasteSeparator": {
          "type": "text",
          "label": {
