              "type": "select",
              "attr": "position",
              "options": [
                {
                  "label": "Before start",
                  "value": "beforeStart"
                },
                {
                  "label": "After start",
                  "value": "afterStart"
                },
                {
                  "label": "Before end",
                  "value": "beforeEnd"
                },
                {
                  "label": "After end",
                  "value": "afterEnd"
                }
              ],
              "label": "Position",
              "xs": 12,
              "sm": 6,
              "md": 6,
              "default": "beforeStart",
              "lg": 6,
              "xl": 6
