              ],
              "default": "exact",
              "disabled": "!data.title",
              "lg": 4,
              "xl": 4
            },
            {
              "type": "text",
              "attr": "description",
              "label": "Notes / description",
              "xs": 12,
              "sm": 6,
              "md": 8,
              "default": "",
              "newLine": true,
              "help": "Blank = all events. Case-insensitive.",
              "lg": 8,
              "xl": 8
            },
            {
              "type": "select",
              "attr": "descriptionMatchMode",
              "label": "Comparison",
              "xs": 12,
              "sm": 6,
              "md": 4,
              "options": [
                {
                  "label": "Matches exactly",
                  "value": "exact"
                },
                {
                  "label": "Contains",
                  "value": "contains"
                }
              ],
              "default": "exact",
              "disabled": "!data.description",
              "lg": 4,
              "xl": 4
            },
            {
              "type": "header",
              "text": "When to fire?",
