{
  "$schema": "https://raw.githubusercontent.com/ioBroker/ioBroker.admin/master/packages/jsonConfig/schemas/jsonConfig.json",
  "i18n": true,
  "type": "tabs",
  "items": {
    "connection": {
      "type": "panel",
      "label": {
        "de": "Verbindung",
        "en": "Connection"
      },
      "items": {
        "_heading": {
          "type": "header",
          "text": {
            "de": "FamilienPlan verbinden",
            "en": "Connect FamilienPlan"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "_intro": {
          "type": "staticText",
          "text": {
            "de": "Verbinde deinen Familienkalender und prüfe, welche Daten freigegeben sind.",
            "en": "Connect your family calendar and check which data is available."
          },
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          }
        },
        "_access": {
          "type": "header",
          "text": {
            "de": "Zugang",
            "en": "Access"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "baseUrl": {
          "type": "text",
          "label": {
            "de": "FamilienPlan-Basis-URL",
            "en": "FamilienPlan base URL"
          },
          "sm": 12,
          "validator": "!data.baseUrl || /^https?:\\/\\//.test(data.baseUrl)",
          "validatorErrorText": "Bitte eine gültige HTTP- oder HTTPS-URL eingeben.",
          "validatorNoSaveOnError": true,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          },
          "newLine": false
        },
        "apiKey": {
          "type": "password",
          "label": {
            "de": "API-Schlüssel",
            "en": "API key"
          },
          "sm": 12,
          "newLine": false,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "test": {
          "type": "sendTo",
          "label": {
            "de": "Verbindung und Berechtigungen testen",
            "en": "Test connection and permissions"
          },
          "command": "testConnection",
          "jsonData": "{\"baseUrl\":\"${data.baseUrl}\",\"apiKey\":\"${data.apiKey}\",\"timezone\":\"${data.timezone}\",\"httpTimeout\":${data.httpTimeout},\"verifySsl\":${data.verifySsl},\"pastDays\":${data.pastDays},\"futureDays\":${data.futureDays},\"rangePeriod\":\"${data.rangePeriod}\",\"childIds\":\"${data.childIds}\"}",
          "showProcess": true,
          "timeout": 30000,
          "variant": "contained",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "_settings": {
          "type": "header",
          "text": {
            "de": "Zeit & Verbindung",
            "en": "Time & connection"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "timezone": {
          "type": "text",
          "label": {
            "de": "Zeitzone",
            "en": "Time zone"
          },
          "default": "Europe/Berlin",
          "sm": 6,
          "xs": 12,
          "md": 4,
          "style": {
            "marginBottom": 12
          }
        },
        "httpTimeout": {
          "type": "number",
          "label": {
            "de": "HTTP-Timeout (ms)",
            "en": "HTTP timeout (ms)"
          },
          "min": 1000,
          "max": 120000,
          "sm": 6,
          "xs": 12,
          "md": 4,
          "style": {
            "marginBottom": 12
          }
        },
        "verifySsl": {
          "type": "checkbox",
          "label": {
            "de": "SSL-Zertifikat prüfen",
            "en": "Verify SSL certificate"
          },
          "help": {
            "de": "Deaktivieren ist unsicher und erzeugt eine Warnung im Log.",
            "en": "Disabling is insecure and creates a log warning."
          },
          "sm": 6,
          "xs": 12,
          "md": 4,
          "style": {
            "marginBottom": 12
          }
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
    },
    "polling": {
      "type": "panel",
      "label": {
        "de": "Abruf",
        "en": "Polling"
      },
      "items": {
        "_heading": {
          "type": "header",
          "text": {
            "de": "Kalender synchronisieren",
            "en": "Synchronize your calendar"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "_intro": {
          "type": "staticText",
          "text": {
            "de": "Lege fest, welche Termine geladen werden und wie oft sie aktualisiert werden.",
            "en": "Choose which events to load and how often to update them."
          },
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          }
        },
        "_range": {
          "type": "header",
          "text": {
            "de": "Zeitraum & Rhythmus",
            "en": "Range & schedule"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "rangePeriod": {
          "type": "select",
          "label": {
            "de": "Zeitraum",
            "en": "Period"
          },
          "options": [
            {
              "label": {
                "de": "Diese Woche",
                "en": "This week"
              },
              "value": "week"
            },
            {
              "label": {
                "de": "Dieser Monat",
                "en": "This month"
              },
              "value": "month"
            },
            {
              "label": {
                "de": "Dieses Quartal",
                "en": "This quarter"
              },
              "value": "quarter"
            },
            {
              "label": {
                "de": "Dieses Jahr",
                "en": "This year"
              },
              "value": "year"
            }
          ],
          "default": "year",
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "pastDays": {
          "type": "number",
          "label": {
            "de": "Vorherige Tage",
            "en": "Previous days"
          },
          "help": {
            "de": "Erweitert den gewählten Zeitraum vor dessen Beginn.",
            "en": "Extends the selected period before its start."
          },
          "min": 0,
          "max": 365,
          "default": 31,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "futureDays": {
          "type": "number",
          "label": {
            "de": "Nachfolgende Tage",
            "en": "Following days"
          },
          "help": {
            "de": "Erweitert den gewählten Zeitraum nach dessen Ende.",
            "en": "Extends the selected period after its end."
          },
          "min": 0,
          "max": 365,
          "default": 31,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "pollInterval": {
          "type": "number",
          "label": {
            "de": "Intervall (Minuten)",
            "en": "Interval (minutes)"
          },
          "min": 1,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "_selection": {
          "type": "header",
          "text": {
            "de": "Kinder & Betreuung",
            "en": "Children & custody"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "childIds": {
          "type": "text",
          "label": {
            "de": "Kind-IDs (kommagetrennt, leer = alle)",
            "en": "Child IDs (comma-separated, blank = all)"
          },
          "help": {
            "de": "Optional auf bestimmte Kinder einschränken. Leer lädt die freigegebenen Kalenderdaten aller Kinder.",
            "en": "Optionally restrict the query to specific children. Empty loads permitted calendar data for all children."
          },
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "fetchLocations": {
          "type": "checkbox",
          "label": {
            "de": "Aufenthalts-/Betreuungsstatus abrufen",
            "en": "Fetch custody/location status"
          },
          "help": {
            "de": "Lädt je Kind die aktuell verantwortliche Person, Quelle, Gültigkeit und den nächsten Wechsel. Es werden keine GPS-Koordinaten abgerufen.",
            "en": "Loads the currently responsible person, source, validity and next change for each child. No GPS coordinates are retrieved."
          },
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "_recovery": {
          "type": "header",
          "text": {
            "de": "Wiederholungen & Aufbewahrung",
            "en": "Retries & retention"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "retryCount": {
          "type": "number",
          "label": {
            "de": "Wiederholungsversuche",
            "en": "Retries"
          },
          "min": 0,
          "max": 10,
          "newLine": true,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "retryBackoff": {
          "type": "number",
          "label": {
            "de": "Backoff-Basis (ms)",
            "en": "Backoff base (ms)"
          },
          "min": 100,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "eventRetentionDays": {
          "type": "number",
          "label": {
            "de": "Objekt-Aufbewahrung (Tage)",
            "en": "Object retention (days)"
          },
          "help": {
            "de": "So lange bleiben Einzelobjekte erhalten, nachdem sie nicht mehr von der API geliefert wurden. Sie werden sofort inaktiv und erst nach dieser Frist gelöscht.",
            "en": "How long individual objects remain after the API no longer returns them. They become inactive immediately and are deleted after this period."
          },
          "min": 0,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
    },
    "timeline": {
      "type": "panel",
      "label": "Timeline",
      "items": {
        "_heading": {
          "type": "header",
          "text": {
            "de": "Deine Tagesübersicht",
            "en": "Your daily overview"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "_intro": {
          "type": "staticText",
          "text": {
            "de": "Fasse Termine zu einer übersichtlichen Timeline zusammen.",
            "en": "Combine events into an easy-to-read daily timeline."
          },
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          }
        },
        "_scope": {
          "type": "header",
          "text": {
            "de": "Inhalt der Timeline",
            "en": "Timeline contents"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "timelineEnabled": {
          "type": "checkbox",
          "label": {
            "de": "Aktiviert",
            "en": "Enabled"
          },
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "timelineDays": {
          "type": "number",
          "label": {
            "de": "Tage",
            "en": "Days"
          },
          "min": 1,
          "max": 366,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "timelineTypes": {
          "type": "text",
          "label": {
            "de": "Typen (kommagetrennt, leer = alle)",
            "en": "Types (comma-separated, blank = all)"
          },
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "_format": {
          "type": "header",
          "text": {
            "de": "Text & Darstellung",
            "en": "Text & formatting"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "timelineTemplate": {
          "type": "text",
          "label": {
            "de": "Eintragsvorlage",
            "en": "Entry template"
          },
          "help": {
            "de": "Platzhalter: {title}, {time}, {date}, {type}. Beispiel: {time} · {title}",
            "en": "Placeholders: {title}, {time}, {date}, {type}. Example: {time} · {title}"
          },
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "md": 12,
          "style": {
            "marginBottom": 12
          }
        },
        "timelineSeparator": {
          "type": "text",
          "label": {
            "de": "Trennzeichen",
            "en": "Separator"
          },
          "sm": 6,
          "xs": 12,
          "md": 2,
          "style": {
            "marginBottom": 12
          }
        },
        "timeFormat": {
          "type": "text",
          "label": {
            "de": "Zeitformat",
            "en": "Time format"
          },
          "sm": 6,
          "xs": 12,
          "md": 2,
          "style": {
            "marginBottom": 12
          }
        },
        "dateFormat": {
          "type": "text",
          "label": {
            "de": "Datumsformat",
            "en": "Date format"
          },
          "sm": 6,
          "xs": 12,
          "md": 2,
          "style": {
            "marginBottom": 12
          }
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
    },
    "birthdays": {
      "type": "panel",
      "label": {
        "de": "Geburtstage",
        "en": "Birthdays"
      },
      "items": {
        "_heading": {
          "type": "header",
          "text": {
            "de": "Geburtstage im Blick",
            "en": "Keep track of birthdays"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "_intro": {
          "type": "staticText",
          "text": {
            "de": "Gestalte die Geburtstagstexte für deine Anzeigen und Automationen.",
            "en": "Customize birthday messages for your displays and automations."
          },
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          }
        },
        "_display": {
          "type": "header",
          "text": {
            "de": "Anzeige",
            "en": "Display"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "birthdaysEnabled": {
          "type": "checkbox",
          "label": {
            "de": "Aktiviert",
            "en": "Enabled"
          },
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "birthdayDateFormat": {
          "type": "text",
          "label": {
            "de": "Datumsformat",
            "en": "Date format"
          },
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "birthdaySeparator": {
          "type": "text",
          "label": {
            "de": "Trennzeichen",
            "en": "Separator"
          },
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          }
        },
        "_templates": {
          "type": "header",
          "text": {
            "de": "Nachrichtenvorlagen",
            "en": "Message templates"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "birthdayTodayTemplate": {
          "type": "text",
          "label": {
            "de": "Vorlage heute",
            "en": "Today template"
          },
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "birthdayTomorrowTemplate": {
          "type": "text",
          "label": {
            "de": "Vorlage morgen",
            "en": "Tomorrow template"
          },
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "birthdayFutureTemplate": {
          "type": "text",
          "label": {
            "de": "Vorlage weitere Tage",
            "en": "Future template"
          },
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "birthdayEmptyText": {
          "type": "text",
          "label": {
            "de": "Leertext",
            "en": "Empty text"
          },
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          }
        },
        "_placeholders": {
          "type": "staticText",
          "text": {
            "de": "Platzhalter: {name}, {age}, {birthDate}, {date}, {days}.",
            "en": "Placeholders: {name}, {age}, {birthDate}, {date}, {days}."
          },
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          }
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
    },
    "waste": {
      "type": "panel",
      "label": {
        "de": "Abfall",
        "en": "Waste"
      },
      "items": {
        "_heading": {
          "type": "header",
          "text": {
            "de": "Keine Abholung verpassen",
            "en": "Never miss a collection"
          },
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          }
        },
        "_intro": {
          "type": "staticText",
          "text": {
            "de": "Passe Abholhinweise an und vergib verständliche Namen für Abfallarten.",
            "en": "Customize collection reminders and give waste types clear names."
          },
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          }
        },
        "_display": {
          "type": "header",
          "text": {
            "de": "Anzeige",
