{
  "i18n": true,
  "type": "tabs",
  "items": {
    "connection": {
      "type": "panel",
      "label": "Connection",
      "items": {
        "_heading": {
          "type": "header",
          "text": "Connect FamilienPlan",
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          },
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_intro": {
          "type": "staticText",
          "text": "Connect your family calendar and check which data is available.",
          "xs": 12,
          "style": {
            "opacity": 0.8,
            "marginBottom": 16,
            "lineHeight": "1.6"
          },
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_access": {
          "type": "header",
          "text": "Access",
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          },
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "baseUrl": {
          "type": "text",
          "label": "FamilienPlan base URL",
          "sm": 12,
          "validator": "!data.baseUrl || /^https?:\\/\\//.test(data.baseUrl)",
          "validatorErrorText": "Bitte eine gültige HTTP- oder HTTPS-URL eingeben.",
          "validatorNoSaveOnError": true,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          },
          "newLine": false,
          "lg": 6,
          "xl": 6
        },
        "apiKey": {
          "type": "password",
          "label": "API key",
          "sm": 12,
          "newLine": false,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          },
          "lg": 6,
          "xl": 6
        },
        "test": {
          "type": "sendTo",
          "label": "Test connection and permissions",
          "command": "testConnection",
          "jsonData": "{\"baseUrl\":\"${data.baseUrl}\",\"apiKey\":\"${data.apiKey}\",\"timezone\":\"${data.timezone}\",\"httpTimeout\":${data.httpTimeout},\"verifySsl\":${data.verifySsl},\"pastDays\":${data.pastDays},\"futureDays\":${data.futureDays},\"rangePeriod\":\"${data.rangePeriod}\",\"childIds\":\"${data.childIds}\"}",
          "showProcess": true,
          "timeout": 30000,
          "variant": "contained",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "md": 6,
          "style": {
            "marginBottom": 12
          },
          "lg": 6,
          "xl": 6
        },
        "_settings": {
          "type": "header",
          "text": "Time & connection",
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          },
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "timezone": {
          "type": "text",
          "label": "Time zone",
          "default": "Europe/Berlin",
          "sm": 6,
          "xs": 12,
          "md": 4,
          "style": {
            "marginBottom": 12
          },
          "lg": 4,
          "xl": 4
        },
        "httpTimeout": {
          "type": "number",
          "label": "HTTP timeout (ms)",
          "min": 1000,
          "max": 120000,
          "sm": 6,
          "xs": 12,
          "md": 4,
          "style": {
            "marginBottom": 12
          },
          "lg": 4,
          "xl": 4
        },
        "verifySsl": {
          "type": "checkbox",
          "label": "Verify SSL certificate",
          "help": "Disabling is insecure and creates a log warning.",
          "sm": 6,
          "xs": 12,
          "md": 4,
          "style": {
            "marginBottom": 12
          },
          "lg": 4,
          "xl": 4
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
    },
    "polling": {
      "type": "panel",
      "label": "Polling",
      "items": {
        "_heading": {
          "type": "header",
