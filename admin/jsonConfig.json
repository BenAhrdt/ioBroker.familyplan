          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          },
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "childIds": {
          "type": "text",
          "label": "Child IDs (comma-separated, blank = all)",
