    "timetable": {
      "type": "panel",
      "label": "Timetable",
      "items": {
        "_intro": {
          "type": "staticText",
          "text": "Requires the timetable extension on the FamilienPlan server and read:children. Shows planned lessons, not substitutions. Holidays only apply when stored as days off in the plan.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "timetableEnabled": {
          "type": "checkbox",
          "label": "Fetch timetables",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "timetableInterval": {
          "type": "number",
          "label": "Polling interval (seconds)",
          "min": 10,
          "default": 60,
          "disabled": "!data.timetableEnabled",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    }
