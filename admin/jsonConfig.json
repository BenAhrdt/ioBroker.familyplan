              "md": 3,
              "default": 0,
              "lg": 3,
              "xl": 3
            },
            {
              "type": "select",
              "attr": "unit",
              "options": [
                {
                  "label": "seconds",
                  "value": "seconds"
                },
                {
                  "label": "minutes",
                  "value": "minutes"
                },
                {
                  "label": "hours",
                  "value": "hours"
                },
                {
                  "label": "days",
                  "value": "days"
                }
              ],
              "label": "Unit",
              "xs": 12,
              "sm": 6,
              "md": 3,
              "default": "minutes",
              "lg": 3,
              "xl": 3
            },
            {
              "type": "header",
              "text": "How long active?",
              "size": 4,
              "xs": 12,
              "newLine": true,
              "style": {
                "marginTop": 24,
                "marginBottom": 8
              },
              "attr": "_section16",
              "sm": 12,
              "md": 12,
              "lg": 12,
              "xl": 12
            },
            {
              "type": "text",
              "attr": "catchUpSeconds",
              "help": "Blank = stays active until triggers.<rule>.reset is set to true. Further firings still increment the counter.",
              "default": 60,
              "label": "Trigger length",
              "xs": 12,
              "sm": 6,
              "md": 8,
              "newLine": true,
              "validator": "data.catchUpSeconds == null || String(data.catchUpSeconds).trim() === '' || (/^\\d+$/.test(String(data.catchUpSeconds)) && Number(data.catchUpSeconds) > 0 && Number.isSafeInteger(Number(data.catchUpSeconds)))",
              "validatorNoSaveOnError": true,
              "validatorErrorText": "Leer lassen oder eine positive ganze Zahl eingeben.",
              "lg": 8,
              "xl": 8
            },
            {
              "type": "select",
              "attr": "lengthUnit",
              "label": "Trigger length unit",
              "xs": 12,
              "sm": 6,
              "md": 4,
              "options": [
                {
                  "label": "seconds",
                  "value": "seconds"
                },
                {
                  "label": "minutes",
                  "value": "minutes"
                },
                {
                  "label": "hours",
                  "value": "hours"
                },
                {
                  "label": "days",
                  "value": "days"
                }
              ],
              "default": "seconds",
              "disabled": "data.catchUpSeconds == null || String(data.catchUpSeconds).trim() === ''",
              "lg": 4,
              "xl": 4
            },
            {
              "type": "header",
              "text": "Missed firings",
              "size": 4,
              "xs": 12,
              "newLine": true,
              "style": {
                "marginTop": 24,
                "marginBottom": 8
              },
              "attr": "_section19",
              "sm": 12,
              "md": 12,
              "lg": 12,
              "xl": 12
            },
            {
              "type": "number",
              "attr": "catchUpWindowSeconds",
              "label": "Catch-up window (seconds)",
              "xs": 12,
              "sm": 6,
              "md": 6,
              "min": 1,
              "default": 60,
              "help": "Missed firings are caught up only within this window. Independent of trigger length.",
              "lg": 6,
              "xl": 6
            }
          ],
          "xs": 12,
          "sm": 12,
          "md": 12,
          "newLine": true,
          "lg": 12,
          "xl": 12
        },
        "_history": {
          "type": "header",
          "text": "History",
          "size": 3,
          "xs": 12,
          "newLine": true,
          "style": {
            "marginTop": 24,
            "marginBottom": 8
          },
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "triggerHistoryDays": {
          "type": "number",
          "label": "History retention (days)",
