              "xs": 12,
              "newLine": true,
              "style": {
                "marginTop": 24,
                "marginBottom": 8
              },
              "attr": "_section3",
              "sm": 12,
              "md": 12,
              "lg": 12,
              "xl": 12
            },
            {
              "type": "select",
              "attr": "eventType",
              "options": [
                {
                  "label": "All event types",
                  "value": ""
                },
                {
                  "label": "General",
                  "value": "GENERAL"
                },
                {
                  "label": "Stay",
                  "value": "STAY"
                },
                {
                  "label": "School",
                  "value": "SCHOOL"
                },
                {
                  "label": "School holiday",
                  "value": "SCHOOL_HOLIDAY"
                },
                {
                  "label": "Birthday",
                  "value": "BIRTHDAY"
                },
                {
                  "label": "Private",
                  "value": "PRIVATE"
                },
                {
                  "label": "Waste",
                  "value": "WASTE"
                },
                {
                  "label": "Cleaning",
                  "value": "CLEANING"
                },
                {
                  "label": "Other",
                  "value": "OTHER"
                }
              ],
              "label": "Event type",
              "xs": 12,
              "sm": 6,
              "md": 6,
              "default": "",
              "lg": 6,
              "xl": 6
            },
            {
              "type": "text",
              "attr": "customTypeLabel",
              "hidden": "data.eventType !== 'OTHER'",
              "label": "Custom event type",
              "xs": 12,
              "sm": 6,
              "md": 6,
              "default": "",
              "lg": 6,
              "xl": 6
            },
            {
              "type": "text",
              "attr": "childName",
              "help": "Blank = all children. Case-insensitive.",
              "label": "Child",
              "xs": 12,
              "sm": 6,
              "md": 6,
              "default": "",
              "lg": 6,
              "xl": 6
            },
            {
              "type": "text",
              "attr": "responsibleName",
              "help": "Blank = all people. Case-insensitive.",
              "hidden": "data.eventType && data.eventType !== 'STAY'",
              "label": "Responsible person",
              "xs": 12,
              "sm": 6,
              "md": 6,
              "default": "",
              "lg": 6,
              "xl": 6
            },
            {
              "type": "text",
              "attr": "title",
              "label": "Title",
              "xs": 12,
              "sm": 6,
              "md": 8,
              "default": "",
