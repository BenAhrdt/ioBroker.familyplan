            "marginTop": 24,
            "marginBottom": 8
          },
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_intro": {
          "type": "staticText",
          "text": "One expandable form per rule. Choose matching events, firing time and how long the trigger stays active.",
