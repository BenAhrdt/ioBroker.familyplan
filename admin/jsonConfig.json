          "min": 100,
          "sm": 6,
          "xs": 12,
          "md": 3,
          "style": {
            "marginBottom": 12
          },
          "lg": 3,
          "xl": 3
        },
        "eventRetentionDays": {
          "type": "number",
          "label": "Object retention (days)",
