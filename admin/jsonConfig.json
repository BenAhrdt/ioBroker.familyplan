          "max": 3650,
          "sm": 6,
          "xs": 12,
          "md": 4,
          "style": {
            "marginBottom": 12
          },
          "lg": 4,
          "xl": 4
        }
      },
      "style": {
        "maxWidth": 1280,
        "margin": "0 auto",
        "padding": "8px 20px 32px",
        "boxSizing": "border-box"
      }
