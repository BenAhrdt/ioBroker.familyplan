{
  "name": "iobroker.familyplan",
  "version": "0.1.1",
  "description": "FamilienPlan calendar integration for ioBroker",
  "author": {
    "name": "Ben Schmidt",
    "email": "github@ben-schmidt.net"
  },
  "contributors": [],
  "homepage": "https://github.com/BenAhrdt/ioBroker.familyplan",
  "license": "MIT",
  "keywords": [
    "iobroker",
    "calendar",
    "family",
    "familyplan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenAhrdt/ioBroker.familyplan.git"
  },
  "bugs": {
    "url": "https://github.com/BenAhrdt/ioBroker.familyplan/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "dev-server": "dev-server",
    "release": "release-script",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "mocha --require ts-node/register --extension ts \"src/**/*.test.ts\"",
    "test:package": "mocha test/package.test.js --exit",
    "test:integration": "mocha test/integration.test.js --exit",
    "test": "npm run test:unit && npm run test:package",
    "validate": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "luxon": "^3.7.2",
    "undici": "^7.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/chai": "^4.3.20",
    "@types/iobroker": "npm:@iobroker/types@^7.1.0",
    "@types/luxon": "^3.7.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "chai": "^4.5.0",
    "eslint": "^9.35.0",
    "mocha": "^11.7.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "readmeFilename": "README.md"
}
